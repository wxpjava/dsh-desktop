# 国内镜像：Electron 二进制与 electron-builder 打包工具链（NSIS 等）都从 GitHub 下载，
# 直连经常超时，这里统一走 npmmirror。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 组装内置 host 时会一次安装上百个本地 tarball；npm 10 在解析 vitest 等 peer 时
# 可能抛出 Cannot read properties of null (reading 'edgesOut')，用 legacy peer 解析规避。
legacy-peer-deps=true
